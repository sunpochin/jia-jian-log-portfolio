  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "React App keeps the current patient scope explicit",
        "Supabase Auth supplies the session and JWT",
        "Postgres RLS remains the real authorization boundary"
      ]
    },
    {
      "dot": "emerald",
      "title": "Offline safety",
      "items": [
        "Local cache is a labeled fallback, not server truth",
        "Transient write failures enter a patient-scoped pending queue",
        "The UI can recover without weakening RLS"
      ]
    },
    {
      "dot": "rose",
      "title": "Side effects",
      "items": [
        "Edge Functions re-check caller scope before reading care data",
        "Telegram notifications remain a fail-soft side effect",
        "Private photos stay behind Supabase Storage controls"
